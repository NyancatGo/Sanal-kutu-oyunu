  {"id":"tar-h-12","category":"tarih","difficulty":"hard","question":"Türk-Yunan Nüfus Mübadelesi hangi antlaşmayla hükme bağlanmıştır?","answer":"Lozan Antlaşması (1923)","type":"spoken"},
  {"id":"tar-h-13","category":"tarih","difficulty":"hard","question":"Osmanlı'da Tanzimat Fermanı hangi yılda ilan edilmiştir?","answer":"1839","type":"spoken"},
  {"id":"tar-h-14","category":"tarih","difficulty":"hard","question":"Birinci Dünya Savaşı'nda Osmanlı Devleti hangi ittifakın saflarında yer almıştır?","answer":"İttifak Devletleri (Almanya, Avusturya-Macaristan ve Bulgaristan)","type":"spoken"},
  {"id":"tar-h-15","category":"tarih","difficulty":"hard","question":"İttihat ve Terakki Cemiyeti hangi yıl II. Meşrutiyet'i ilan ettirerek iktidara gelmiştir?","answer":"1908","type":"spoken"},
  {"id":"tar-h-16","category":"tarih","difficulty":"hard","question":"Osmanlı'da 'Divan-ı Hümayun' ne işlevini görürdü?","answer":"Devlet işlerinin görüşüldüğü ve padişah adına kararların alındığı en yüksek yönetim kurulu","type":"spoken"},
  {"id":"tar-h-17","category":"tarih","difficulty":"hard","question":"Lozan Antlaşması'nın Türkiye açısından önemi nedir?","answer":"Kurtuluş Savaşı zaferini uluslararası arenada tanıyan ve yeni Türkiye'nin sınırlarını belirleyen antlaşmadır","type":"spoken"},
  {"id":"tar-h-18","category":"tarih","difficulty":"hard","question":"Osmanlı Devleti'nin Birinci Dünya Savaşı'ndan çekilmesini sağlayan mütareke hangisidir?","answer":"Mondros Mütarekesi (1918)","type":"spoken"},
  {"id":"tar-h-19","category":"tarih","difficulty":"hard","question":"Türkiye'de çok partili siyasi hayata geçişte ilk iktidar değişiminin yaşandığı seçim hangi yılda yapılmıştır?","answer":"1950","type":"spoken"},
  {"id":"tar-h-20","category":"tarih","difficulty":"hard","question":"Islahat Fermanı hangi yılda ilan edilmiş ve amacı neydi?","answer":"1856; Osmanlı'da gayrimüslim vatandaşlara Müslümanlarla eşit haklar tanımak amacıyla ilan edilmiştir","type":"spoken"},

  {"id":"zek-h-1","category":"zeka","difficulty":"hard","question":"5 makine 5 dakikada 5 ürün üretiyorsa, 100 makine 100 dakikada kaç ürün üretir?","answer":"2000","type":"spoken","teacherNote":"Her makine 5 dk'da 1 ürün → 100 dk'da 20 ürün. 100 makine × 20 = 2000."},
  {"id":"zek-h-2","category":"zeka","difficulty":"hard","question":"Bir odada 23 kişi olduğunda iki kişinin aynı doğum gününe sahip olma ihtimali %50'den fazla mıdır?","answer":"Evet — bu 'Doğum Günü Paradoksu' olarak bilinir","type":"spoken"},
  {"id":"zek-h-3","category":"zeka","difficulty":"hard","question":"İlk n tek sayının toplamı her zaman ne olur?","answer":"n² (örneğin ilk 10 tek sayının toplamı 10² = 100'dür)","type":"spoken"},
  {"id":"zek-h-4","category":"zeka","difficulty":"hard","question":"Bir çoban 17 koyununu 3 oğluna bırakıyor: büyüğüne yarısını, ortancasına 1/3'ünü, küçüğüne 1/9'unu. Bu nasıl mümkün olur?","answer":"Komşudan 1 koyun ödünç alınır (18 koyun): büyük 9, orta 6, küçük 2 alır — toplam 17, 1 koyun iade edilir","type":"spoken"},
  {"id":"zek-h-5","category":"zeka","difficulty":"hard","question":"ABCD × 4 = DCBA olduğunda ABCD sayısı nedir?","answer":"2178 (2178 × 4 = 8712)","type":"spoken"},
  {"id":"zek-h-6","category":"zeka","difficulty":"hard","question":"2, 3, 5, 7, 11, 13... Dizide sonraki asal sayı nedir?","answer":"17","type":"spoken"},
  {"id":"zek-h-7","category":"zeka","difficulty":"hard","question":"100 kişi birbirleriyle birer kez tokalaşsa toplam kaç el sıkışma olur?","answer":"4950 (100 × 99 ÷ 2)","type":"spoken"},
  {"id":"zek-h-8","category":"zeka","difficulty":"hard","question":"30'u asal çarpanlarına ayırın.","answer":"2 × 3 × 5","type":"spoken"},
  {"id":"zek-h-9","category":"zeka","difficulty":"hard","question":"8 topun biri diğerlerinden ağır; terazi kullanarak en az kaç tartmayla ağır topu bulabilirsiniz?","answer":"2 tartma","type":"spoken","teacherNote":"8 topu 3+3+2 ayır. İlk tartmada 3'e karşı 3 tart: eşitse ağır top 2'nin içinde (2. tartmayla bulunur); ağır taraftaki 3 topu 1'e karşı 1 tart, eşitse 3. toptur."},
  {"id":"zek-h-10","category":"zeka","difficulty":"hard","question":"0,999... (sonsuz 9) sayısı 1'e eşit midir?","answer":"Evet, matematiksel olarak 0,999... = 1'dir","type":"spoken","teacherNote":"Kanıt: x=0,999..., 10x=9,999..., 9x=9, x=1."},
  {"id":"zek-h-11","category":"zeka","difficulty":"hard","question":"111.111.111 × 111.111.111 kaç eder?","answer":"12.345.678.987.654.321","type":"spoken"},
  {"id":"zek-h-12","category":"zeka","difficulty":"hard","question":"Bir satranç tahtasında (8×8) tüm boyutlardaki kare şekillerin toplam sayısı kaçtır?","answer":"204","type":"spoken","teacherNote":"1×1:64, 2×2:49, 3×3:36, 4×4:25, 5×5:16, 6×6:9, 7×7:4, 8×8:1 → toplam 204."},
  {"id":"zek-h-13","category":"zeka","difficulty":"hard","question":"3×3 sihirli karede 1'den 9'a kadar sayılar kullanılır; her satır, sütun ve köşegen eşit toplam verir. Bu toplam kaçtır?","answer":"15","type":"spoken","teacherNote":"1+2+...+9=45, 45÷3=15."},
  {"id":"zek-h-14","category":"zeka","difficulty":"hard","question":"3 kapıdan birinin arkasında ödül var. Birini seçiyorsunuz; sunucu boş bir kapıyı açıyor. Kapınızı değiştirmeli misiniz?","answer":"Evet! Değiştirirseniz kazanma ihtimaliniz 2/3 olur (Monty Hall paradoksu)","type":"spoken"},
  {"id":"zek-h-15","category":"zeka","difficulty":"hard","question":"1 + 2 + 3 + ... + n toplamının formülü nedir?","answer":"n × (n + 1) ÷ 2","type":"spoken"},
  {"id":"zek-h-16","category":"zeka","difficulty":"hard","question":"İki asal sayının çarpımı 77'dir. Bu asal sayılar hangileridir?","answer":"7 ve 11 (7 × 11 = 77)","type":"spoken"},
  {"id":"zek-h-17","category":"zeka","difficulty":"hard","question":"Bir sayının karesinden 1 çıkarıldığında 80 elde ediliyorsa bu sayı kaçtır?","answer":"9 (9² − 1 = 80)","type":"spoken"},
  {"id":"zek-h-18","category":"zeka","difficulty":"hard","question":"4 basamaklı en küçük asal sayı hangisidir?","answer":"1009","type":"spoken"},
  {"id":"zek-h-19","category":"zeka","difficulty":"hard","question":"Altın oran (φ) yaklaşık kaçtır ve nasıl tanımlanır?","answer":"Yaklaşık 1,618; iki sayının oranının büyüğün küçüğe oranına eşit olduğu değer: φ = (1 + √5) ÷ 2","type":"spoken"},
  {"id":"zek-h-20","category":"zeka","difficulty":"hard","question":"Biri hep doğru, biri hep yalan söyleyen iki bekçi var. Tek bir soruyla doğru kapıyı nasıl bulursunuz?","answer":"Herhangi birine 'Diğer bekçi hangi kapının doğru olduğunu söyler?' diye sorun — verilen cevabın tersini seçin","type":"spoken"}
]
